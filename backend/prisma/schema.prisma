datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "./generated/client"
  moduleFormat = "cjs"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  username String @unique

  level Int @default(1)
  exp   Int @default(0)
  gold  Int @default(0)

  hp    Int @default(100)
  maxHp Int @default(100)

  // Base character stats (progression + manual upgrades). Equipment/perk
  // bonuses are layered on top at read time — never written back here.
  strength       Int @default(5)
  agility        Int @default(5)
  accuracy       Int @default(5)
  endurance      Int @default(5)
  criticalDamage Int @default(150) // percent multiplier: 150 => crits deal 150%
  defense        Int @default(0)

  statPoints Int @default(0)
  perkPoints Int @default(0)

  isDead      Boolean  @default(false)
  hpUpdatedAt DateTime @default(now()) // anchor for lazy HP regeneration

  currentLocationId Int?
  currentLocation   Location? @relation(fields: [currentLocationId], references: [id])
  posX              Int       @default(1)
  posY              Int       @default(2)

  ownedEquipment UserEquipment[]
  perks          UserPerk[]
  battles        Battle[]
  inventory      InventoryItem[]
  riftRuns       RiftRun[]
  exploredTiles  UserExploredTile[]

  createdAt DateTime @default(now())
}

enum EquipmentSlot {
  WEAPON
  HELMET
  BODY
  PANTS
  GLOVES
}

// A piece of gear that can occupy an equipment slot. Stat modifiers are stored
// as explicit columns (may be positive or negative). Weapon-only combat fields
// (baseDamage/attackSpeed) are null for armor.
model EquipmentItem {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  slot        EquipmentSlot
  rarity      ItemRarity    @default(COMMON)
  description String?
  sellValue   Int           @default(0)

  // Shop metadata: price to buy, minimum character level required to equip
  // (an item can be bought ahead of that level but not worn until then), and
  // an optional MDI icon override (weapons only; armor falls back to slot icon).
  price    Int     @default(0)
  minLevel Int     @default(1)
  icon     String?

  strength       Int @default(0)
  agility        Int @default(0)
  accuracy       Int @default(0)
  endurance      Int @default(0)
  criticalDamage Int @default(0)
  defense        Int @default(0)

  baseDamage  Int   @default(0) // weapon contribution to attack damage
  attackSpeed Float? // weapon only; null for armor

  owners       UserEquipment[]
  shopListings ShopListing[]
}

// Gear a player owns; `equipped` marks it as active in its slot. At most one
// equipped item per slot is enforced in the service layer.
model UserEquipment {
  id              Int     @id @default(autoincrement())
  userId          Int
  equipmentItemId Int
  equipped        Boolean @default(false)

  user          User          @relation(fields: [userId], references: [id])
  equipmentItem EquipmentItem @relation(fields: [equipmentItemId], references: [id])

  @@index([userId])
}

// Perks are defined in code (perks.config.ts); this table records which a
// player has unlocked. perkCode references a PerkDefinition id.
model UserPerk {
  userId   Int
  perkCode String

  user User @relation(fields: [userId], references: [id])

  @@id([userId, perkCode])
}

model Location {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  minLevel    Int     @default(1)

  mapX       Int
  mapY       Int
  gridWidth  Int @default(3)
  gridHeight Int @default(3)

  subLocations SubLocation[]
  players      User[]

  @@unique([mapX, mapY])
}

model SubLocation {
  id          Int     @id @default(autoincrement())
  locationId  Int
  location    Location @relation(fields: [locationId], references: [id])
  name        String
  description String?
  kind        SubLocationKind @default(DANGER)
  minLevel    Int             @default(1)

  gridX Int
  gridY Int

  monsters         SubLocationMonster[]
  battles          Battle[]
  shopListings     ShopListing[]
  shopItemListings ShopItemListing[]

  @@unique([locationId, gridX, gridY])
}

// What a given SHOP sub-location has for sale. Price/minLevel live on the
// EquipmentItem itself; this table is just the catalog assignment.
model ShopListing {
  id              Int @id @default(autoincrement())
  subLocationId   Int
  equipmentItemId Int

  subLocation   SubLocation   @relation(fields: [subLocationId], references: [id])
  equipmentItem EquipmentItem @relation(fields: [equipmentItemId], references: [id])

  @@unique([subLocationId, equipmentItemId])
}

// What a SHOP sells beyond weapons/armor — consumable Items (e.g. Torch).
// A separate table from ShopListing since it points at Item, not EquipmentItem.
model ShopItemListing {
  id            Int @id @default(autoincrement())
  subLocationId Int
  itemId        Int

  subLocation SubLocation @relation(fields: [subLocationId], references: [id])
  item        Item        @relation(fields: [itemId], references: [id])

  @@unique([subLocationId, itemId])
}

enum SubLocationKind {
  SAFE
  SHOP // sells weapons/armor (buy only)
  LOOT_SHOP // buys monster loot for gold (sell only) — deliberately a separate tile from SHOP
  DANGER
}

model Monster {
  id          Int    @id @default(autoincrement())
  name        String
  maxHp       Int
  damage      Int
  defense     Int    @default(0)
  attackSpeed Float
  expReward   Int
  goldReward  Int

  // Key into MONSTER_AI_PROFILES (battle/engine/monster-ai.config.ts):
  // intent weights + reactive triggers. Null = plain attacker.
  aiProfile String?

  subLocations SubLocationMonster[]
  battles      Battle[]
  loot         MonsterLoot[]
  riftTiles    RiftTile[]
}

model Item {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  sellValue   Int
  rarity      ItemRarity @default(COMMON)

  // Set only for items a shop actually sells (e.g. Torch). Null means the
  // item is never purchasable — only ever found (e.g. Rusty Key, monster loot).
  buyPrice Int?

  drops         MonsterLoot[]
  inventory     InventoryItem[]
  gatesOpened   RiftTile[]        @relation("RiftGateItem")
  resourceTiles RiftTile[]        @relation("RiftResourceItem")
  shopListings  ShopItemListing[]
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
}

model MonsterLoot {
  monsterId   Int
  itemId      Int
  dropChance  Int @default(50)
  minQuantity Int @default(1)
  maxQuantity Int @default(1)

  monster Monster @relation(fields: [monsterId], references: [id])
  item    Item    @relation(fields: [itemId], references: [id])

  @@id([monsterId, itemId])
}

model InventoryItem {
  id       Int @id @default(autoincrement())
  userId   Int
  itemId   Int
  quantity Int @default(1)

  user User @relation(fields: [userId], references: [id])
  item Item @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
}

model SubLocationMonster {
  subLocationId Int
  monsterId     Int
  spawnWeight   Int @default(100)

  subLocation SubLocation @relation(fields: [subLocationId], references: [id])
  monster     Monster     @relation(fields: [monsterId], references: [id])

  @@id([subLocationId, monsterId])
}

model Battle {
  id        Int     @id @default(autoincrement())
  userId    Int
  user      User    @relation(fields: [userId], references: [id])
  monsterId Int
  monster   Monster @relation(fields: [monsterId], references: [id])

  // Exactly one of these is set: a battle happens either on a static
  // sub-location tile or on a rift tile.
  subLocationId Int?
  subLocation   SubLocation? @relation(fields: [subLocationId], references: [id])
  riftTileId    Int?
  riftTile      RiftTile?    @relation(fields: [riftTileId], references: [id])

  monsterCurrentHp    Int
  lastPlayerAttackAt  DateTime?
  lastMonsterAttackAt DateTime  @default(now())

  // Dynamic combat state (momentum, statuses, intent, skill cooldowns,
  // trigger counters) owned by the battle engine. Shape: engine/types.ts.
  state Json?

  status BattleStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum BattleStatus {
  ACTIVE
  WON
  LOST
  FLED
}

// --- Rifts: procedurally generated, shared, expiring dungeons ---

enum RiftTileKind {
  ENTRANCE // spawn point; extraction is possible anywhere, this is just the anchor
  PATH
  MONSTER
  BOSS // one per rift — a tougher monster with guaranteed rare loot
  RESOURCE // gatherable node, shared across players and depleting (charges)
  CHEST // one-time treasure (gold + item); once opened it never respawns
  LOCKED // gate: needs the key item to step onto (consumed per player)
  DARK // gate: needs a torch to step onto (consumed per player)
}

enum RiftRunStatus {
  ACTIVE
  EXTRACTED
  DEAD
}

model Rift {
  id       Int    @id @default(autoincrement())
  name     String
  tier     Int    @default(1)
  minLevel Int    @default(1)
  seed     Int

  gridWidth  Int
  gridHeight Int
  entranceX  Int
  entranceY  Int

  // Position on the overworld grid — a rift is a node on the same map as
  // Locations, reached by walking to it (see RiftWorldService.pickFreeCell).
  mapX Int
  mapY Int

  expiresAt DateTime
  createdAt DateTime @default(now())

  tiles RiftTile[]
  runs  RiftRun[]

  @@unique([mapX, mapY])
}

// The rift map is shared world state: monster kills and resource depletion are
// stored here (respawnAt), while per-player visibility lives in UserExploredTile.
model RiftTile {
  id     Int          @id @default(autoincrement())
  riftId Int
  rift   Rift         @relation(fields: [riftId], references: [id], onDelete: Cascade)
  x      Int
  y      Int
  kind   RiftTileKind
  name   String
  depth  Int // BFS distance from the entrance — scales danger and loot

  // Groups tiles into a visual "room" (3-5+ cells) vs. a bare 1-wide
  // corridor tile (null). Scoped to this rift only — not a global id.
  roomId Int?

  requiredItemId Int? // LOCKED/DARK: item consumed to open
  requiredItem   Item? @relation("RiftGateItem", fields: [requiredItemId], references: [id])

  monsterId Int?
  monster   Monster? @relation(fields: [monsterId], references: [id])

  // RESOURCE: renewable gathering node. CHEST: one-time treasure (reuses the
  // same fields; maxCharges is always 1 and never respawns once emptied).
  resourceItemId Int?
  resourceItem   Item? @relation("RiftResourceItem", fields: [resourceItemId], references: [id])
  maxCharges     Int   @default(0)
  charges        Int   @default(0)
  goldReward     Int   @default(0) // CHEST only — paid out immediately, not staged

  // Shared cooldown: a killed monster / emptied resource node is inactive
  // until this instant passes (lazy respawn — no background job).
  respawnAt DateTime?

  battles  Battle[]
  explored UserExploredTile[]

  @@unique([riftId, x, y])
}

// One extraction run per player per rift visit. Loot gathered inside the rift
// is staged here (at risk) and only banked to the inventory on extraction —
// dying forfeits part of it.
model RiftRun {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])
  riftId Int
  rift   Rift @relation(fields: [riftId], references: [id], onDelete: Cascade)

  x Int
  y Int

  status RiftRunStatus @default(ACTIVE)
  // Staged loot: [{ itemId, name, rarity, quantity }]
  loot   Json          @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// Fog of war: which rift tiles a player has revealed.
model UserExploredTile {
  userId     Int
  riftTileId Int

  user User     @relation(fields: [userId], references: [id])
  tile RiftTile @relation(fields: [riftTileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, riftTileId])
}
