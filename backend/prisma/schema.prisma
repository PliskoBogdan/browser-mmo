datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "./generated/client"
  moduleFormat = "cjs"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  username String @unique

  level Int @default(1)
  exp   Int @default(0)
  gold  Int @default(0)

  hp    Int @default(100)
  maxHp Int @default(100)

  isDead Boolean @default(false)

  currentLocationId Int?
  currentLocation   Location? @relation(fields: [currentLocationId], references: [id])
  posX              Int       @default(1)
  posY              Int       @default(2)

  equipment Equipment?
  battles   Battle[]

  createdAt DateTime @default(now())
}

model Equipment {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  primaryWeaponId   Int?
  primaryWeapon     Weapon? @relation("PrimaryWeapon", fields: [primaryWeaponId], references: [id])

  secondaryWeaponId Int?
  secondaryWeapon   Weapon? @relation("SecondaryWeapon", fields: [secondaryWeaponId], references: [id])
}

model Weapon {
  id          Int    @id @default(autoincrement())
  name        String @unique
  damage      Int
  attackSpeed Float

  primaryEquipments   Equipment[] @relation("PrimaryWeapon")
  secondaryEquipments Equipment[] @relation("SecondaryWeapon")
}

model Location {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  minLevel    Int     @default(1)

  mapX       Int
  mapY       Int
  gridWidth  Int @default(3)
  gridHeight Int @default(3)

  subLocations SubLocation[]
  players      User[]

  @@unique([mapX, mapY])
}

model SubLocation {
  id          Int     @id @default(autoincrement())
  locationId  Int
  location    Location @relation(fields: [locationId], references: [id])
  name        String
  description String?
  kind        SubLocationKind @default(DANGER)
  minLevel    Int             @default(1)

  gridX Int
  gridY Int

  monsters SubLocationMonster[]
  battles  Battle[]

  @@unique([locationId, gridX, gridY])
}

enum SubLocationKind {
  SAFE
  SHOP
  DANGER
}

model Monster {
  id          Int    @id @default(autoincrement())
  name        String
  maxHp       Int
  damage      Int
  attackSpeed Float
  expReward   Int
  goldReward  Int

  subLocations SubLocationMonster[]
  battles      Battle[]
}

model SubLocationMonster {
  subLocationId Int
  monsterId     Int
  spawnWeight   Int @default(100)

  subLocation SubLocation @relation(fields: [subLocationId], references: [id])
  monster     Monster     @relation(fields: [monsterId], references: [id])

  @@id([subLocationId, monsterId])
}

model Battle {
  id            Int         @id @default(autoincrement())
  userId        Int
  user          User        @relation(fields: [userId], references: [id])
  monsterId     Int
  monster       Monster     @relation(fields: [monsterId], references: [id])
  subLocationId Int
  subLocation   SubLocation @relation(fields: [subLocationId], references: [id])

  monsterCurrentHp    Int
  lastPlayerAttackAt  DateTime?
  lastMonsterAttackAt DateTime  @default(now())

  status BattleStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum BattleStatus {
  ACTIVE
  WON
  LOST
  FLED
}
