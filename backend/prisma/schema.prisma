datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "./generated/client"
  moduleFormat = "cjs"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  username String @unique

  level Int @default(1)
  exp   Int @default(0)
  gold  Int @default(0)

  hp    Int @default(100)
  maxHp Int @default(100)

  // Base character stats (progression + manual upgrades). Equipment/perk
  // bonuses are layered on top at read time — never written back here.
  strength       Int @default(5)
  agility        Int @default(5)
  accuracy       Int @default(5)
  endurance      Int @default(5)
  criticalDamage Int @default(150) // percent multiplier: 150 => crits deal 150%
  defense        Int @default(0)

  statPoints Int @default(0)
  perkPoints Int @default(0)

  isDead      Boolean  @default(false)
  hpUpdatedAt DateTime @default(now()) // anchor for lazy HP regeneration

  currentLocationId Int?
  currentLocation   Location? @relation(fields: [currentLocationId], references: [id])
  posX              Int       @default(1)
  posY              Int       @default(2)

  ownedEquipment UserEquipment[]
  perks          UserPerk[]
  battles        Battle[]
  inventory      InventoryItem[]

  createdAt DateTime @default(now())
}

enum EquipmentSlot {
  WEAPON
  HELMET
  BODY
  PANTS
  GLOVES
}

// A piece of gear that can occupy an equipment slot. Stat modifiers are stored
// as explicit columns (may be positive or negative). Weapon-only combat fields
// (baseDamage/attackSpeed) are null for armor.
model EquipmentItem {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  slot        EquipmentSlot
  rarity      ItemRarity    @default(COMMON)
  description String?
  sellValue   Int           @default(0)

  // Shop metadata: price to buy, minimum character level required to equip
  // (an item can be bought ahead of that level but not worn until then), and
  // an optional MDI icon override (weapons only; armor falls back to slot icon).
  price    Int     @default(0)
  minLevel Int     @default(1)
  icon     String?

  strength       Int @default(0)
  agility        Int @default(0)
  accuracy       Int @default(0)
  endurance      Int @default(0)
  criticalDamage Int @default(0)
  defense        Int @default(0)

  baseDamage  Int   @default(0) // weapon contribution to attack damage
  attackSpeed Float? // weapon only; null for armor

  owners       UserEquipment[]
  shopListings ShopListing[]
}

// Gear a player owns; `equipped` marks it as active in its slot. At most one
// equipped item per slot is enforced in the service layer.
model UserEquipment {
  id              Int     @id @default(autoincrement())
  userId          Int
  equipmentItemId Int
  equipped        Boolean @default(false)

  user          User          @relation(fields: [userId], references: [id])
  equipmentItem EquipmentItem @relation(fields: [equipmentItemId], references: [id])

  @@index([userId])
}

// Perks are defined in code (perks.config.ts); this table records which a
// player has unlocked. perkCode references a PerkDefinition id.
model UserPerk {
  userId   Int
  perkCode String

  user User @relation(fields: [userId], references: [id])

  @@id([userId, perkCode])
}

model Location {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  minLevel    Int     @default(1)

  mapX       Int
  mapY       Int
  gridWidth  Int @default(3)
  gridHeight Int @default(3)

  subLocations SubLocation[]
  players      User[]

  @@unique([mapX, mapY])
}

model SubLocation {
  id          Int     @id @default(autoincrement())
  locationId  Int
  location    Location @relation(fields: [locationId], references: [id])
  name        String
  description String?
  kind        SubLocationKind @default(DANGER)
  minLevel    Int             @default(1)

  gridX Int
  gridY Int

  monsters     SubLocationMonster[]
  battles      Battle[]
  shopListings ShopListing[]

  @@unique([locationId, gridX, gridY])
}

// What a given SHOP sub-location has for sale. Price/minLevel live on the
// EquipmentItem itself; this table is just the catalog assignment.
model ShopListing {
  id              Int @id @default(autoincrement())
  subLocationId   Int
  equipmentItemId Int

  subLocation   SubLocation   @relation(fields: [subLocationId], references: [id])
  equipmentItem EquipmentItem @relation(fields: [equipmentItemId], references: [id])

  @@unique([subLocationId, equipmentItemId])
}

enum SubLocationKind {
  SAFE
  SHOP
  DANGER
}

model Monster {
  id          Int    @id @default(autoincrement())
  name        String
  maxHp       Int
  damage      Int
  defense     Int    @default(0)
  attackSpeed Float
  expReward   Int
  goldReward  Int

  // Key into MONSTER_AI_PROFILES (battle/engine/monster-ai.config.ts):
  // intent weights + reactive triggers. Null = plain attacker.
  aiProfile String?

  subLocations SubLocationMonster[]
  battles      Battle[]
  loot         MonsterLoot[]
}

model Item {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  sellValue   Int
  rarity      ItemRarity @default(COMMON)

  drops     MonsterLoot[]
  inventory InventoryItem[]
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
}

model MonsterLoot {
  monsterId   Int
  itemId      Int
  dropChance  Int @default(50)
  minQuantity Int @default(1)
  maxQuantity Int @default(1)

  monster Monster @relation(fields: [monsterId], references: [id])
  item    Item    @relation(fields: [itemId], references: [id])

  @@id([monsterId, itemId])
}

model InventoryItem {
  id       Int @id @default(autoincrement())
  userId   Int
  itemId   Int
  quantity Int @default(1)

  user User @relation(fields: [userId], references: [id])
  item Item @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
}

model SubLocationMonster {
  subLocationId Int
  monsterId     Int
  spawnWeight   Int @default(100)

  subLocation SubLocation @relation(fields: [subLocationId], references: [id])
  monster     Monster     @relation(fields: [monsterId], references: [id])

  @@id([subLocationId, monsterId])
}

model Battle {
  id            Int         @id @default(autoincrement())
  userId        Int
  user          User        @relation(fields: [userId], references: [id])
  monsterId     Int
  monster       Monster     @relation(fields: [monsterId], references: [id])
  subLocationId Int
  subLocation   SubLocation @relation(fields: [subLocationId], references: [id])

  monsterCurrentHp    Int
  lastPlayerAttackAt  DateTime?
  lastMonsterAttackAt DateTime  @default(now())

  // Dynamic combat state (momentum, statuses, intent, skill cooldowns,
  // trigger counters) owned by the battle engine. Shape: engine/types.ts.
  state Json?

  status BattleStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum BattleStatus {
  ACTIVE
  WON
  LOST
  FLED
}
